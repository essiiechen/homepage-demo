# ---- 密钥与配置：绝不进仓库 ----
.env
*.key
*_keys*

# ---- 原始 PDF：不必进仓库，下载脚本可一键重建 ----
data/pdf/

# ---- 解析/索引产物：体积大且可由脚本重建 ----
# 注意：data/bm25.pkl.gz、data/chunks.pkl.gz、data/stats.json 由
# 10_Vercel/预构建_索引.py 生成，是 assets/（前端索引）的上游输入。
# 线上部署其实只需要仓库根的 index.html + assets/，但为了让别人 clone 下来
# 能重跑「预构建 → 打包前端索引」这条链，这三个文件仍然进仓库。
# 所以这里只忽略本地中间产物，不要写成 data/ 或 *.pkl.gz。
data/pages/
data/index/
data/chunks.jsonl
data/manifest.json
data/解析统计.json
data/切块统计.json

# ---- 预构建脚本的本地副本目录（正式产物在仓库根 data/）----
10_Vercel/data/

# ---- 依赖与运行时 ----
tmp/
site/
__pycache__/
*.pyc
nohup.out

# ---- 系统 ----
.DS_Store

# ---- 中间预览 ----
06_结论/tmp_*.png

# ---- 上传包：交付用副本，不进仓库 ----
08_上传包/
*.zip
07_展示/dist/

# ---- 线上部署副本（94MB，由 构建_部署目录.py 生成，不进仓库）----
09_部署/
